{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "38;2;224;224;224" },
    "padding": { "top": 1, "right": 3 },
  },
  "display": {
    "separator": ": ",
    "brightColor": false,
    "color": {
      "keys": "38;2;176;176;176",
      "title": "38;2;224;224;224",
      "separator": "38;2;176;176;176",
    },
    "percent": {
      "color": {
        "green": "38;2;224;224;224",
        "yellow": "38;2;224;224;224",
        "red": "38;2;224;224;224",
      },
    },
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "{#38;2;176;176;176}daniel{#38;2;224;224;224}@{#38;2;176;176;176}DANIELPC",
    },
    "break",
    { "type": "os", "key": "OS" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "display", "key": "Resolution", "compactType": "original" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu", "key": "CPU" },
    { "type": "custom", "key": "GPU", "format": "AMD Radeon RX 6750 XT" },
    { "type": "memory", "key": "Memory" },
    {
      "type": "disk",
      "key": "Disk",
      "format": "{size-used} / {size-total} ({size-percentage})",
    },
    "break",
  ],
}
